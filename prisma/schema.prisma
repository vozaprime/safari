generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  passwordHash     String
  name             String
  role             String    @default("admin") // admin | editor
  tokenVersion     Int       @default(0)
  resetToken       String?
  resetTokenExpiry DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String? // AES-GCM encrypted base32 TOTP secret
  twoFactorBackupCodes String? // JSON array of sha256-hashed recovery codes
  archivedAt       DateTime? // soft-archive: hidden from lists + blocked at login
  createdAt        DateTime  @default(now())
}

model Service {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  icon         String
  image        String               @default("")
  order        Int                  @default(0)
  visible      Boolean              @default(true)
  archivedAt   DateTime? // soft-archive: hidden from admin lists + public site
  translations ServiceTranslation[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userEmail String   @default("")
  action    String // create | update | delete | login | logout | ...
  entity    String // service | reference | content | settings | message | user | auth
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  key       String // email or ip
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model ServiceTranslation {
  id          Int     @id @default(autoincrement())
  serviceId   Int
  locale      String
  title       String
  summary     String
  description String
  scope       String  @default("[]")
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
}

model Reference {
  id         Int       @id @default(autoincrement())
  name       String
  logo       String    @default("")
  order      Int       @default(0)
  visible    Boolean   @default(true)
  archivedAt DateTime? // soft-archive: hidden from admin lists + public site
}

model PageContent {
  id     Int    @id @default(autoincrement())
  key    String
  locale String
  value  String

  @@unique([key, locale])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String   @default("")
  company   String   @default("")
  service   String   @default("")
  message   String
  locale    String   @default("tr")
  status    String   @default("new")
  notes     String   @default("")
  ip        String   @default("")
  archivedAt DateTime? // soft-archive: hidden from default inbox, kept for records
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model Setting {
  key   String @id
  value String
}

model Post {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  cover        String            @default("")
  published    Boolean           @default(false)
  order        Int               @default(0)
  archivedAt   DateTime? // soft-archive: hidden from admin lists + public blog
  createdAt    DateTime          @default(now())
  translations PostTranslation[]
}

model PostTranslation {
  id      Int    @id @default(autoincrement())
  postId  Int
  locale  String
  title   String
  excerpt String @default("")
  body    String @default("")
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
}
